# Copie para .env.local e ajuste conforme necessário.
# Feature flag do checkout V2 (lida pelo handler do MSW em dev):
#   "true"  -> fluxo com escolha de pagamento (Pix/boleto)
#   "false" -> fluxo curto (padrão quando ausente)
#   "error" -> simula a API da flag fora do ar (deve cair no fluxo curto)
NEXT_PUBLIC_CHECKOUT_V2=true
